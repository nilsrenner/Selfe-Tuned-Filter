import matplotlib.pyplot as plt
import numpy as np
import pandas as pd
import os

from scipy.signal import find_peaks

#%% HSB Farben

my_blue = (10/255,85/255,140/255)      #x/255 da HTMP bis 255 sene Farbscala hat und Matplotlib bis 1
my_red = (195/255, 5/255, 35/255)
my_green = (0/255, 145/255, 90/255)
my_yellow = (250/255, 190/255, 0/255)
my_orange = (240/255, 120/255, 35/255)
my_purple = (120/255, 100/255, 165/255)
my_green2 = (110/255, 165/255, 60/255)
my_blue2 = (50/255, 180/255, 200/255)



#%% sim ac gesamtsys

folder_path = '008_LTSpice'
df = pd.read_csv('008_LTSpice/Experiment_05_ges_sys_ac.csv', sep='\t', encoding='cp1252')


# Regex-Muster für die Zahlen (inkl. wissenschaftlicher Notation)
# Wir suchen: (ZAHL dB, ZAHL °)
num = r"([-+]?\d*\.?\d+(?:[eE][-+]?\d+)?)"
pattern = r"\(" + num + r"dB," + num + r"°\)"

# Spalten manuell extrahieren
# V(v_f1)
ext_f1 = df['V(v_f1)'].str.extract(pattern).astype(float)
mag_f1, phase_f1 = ext_f1[0], ext_f1[1]

# V(v_f2)
ext_f2 = df['V(v_f2)'].str.extract(pattern).astype(float)
mag_f2, phase_f2 = ext_f2[0], ext_f2[1]

# V(v_hp)
ext_hp = df['V(v_hp)'].str.extract(pattern).astype(float)
mag_hp, phase_hp = ext_hp[0], ext_hp[1]

# V(v_tp)
ext_tp = df['V(v_tp)'].str.extract(pattern).astype(float)
mag_tp, phase_tp = ext_tp[0], ext_tp[1]

# --- Plot erstellen ---
fig, (ax1, ax2) = plt.subplots(2, 1, figsize=(12, 10), sharex=True)

# Amplituden-Plot (Oben)
ax1.semilogx(df['Freq.'], mag_f1, label='V(v_f1)')
ax1.semilogx(df['Freq.'], mag_f2, label='V(v_f2)')
ax1.semilogx(df['Freq.'], mag_hp, label='V(v_hp)')
ax1.semilogx(df['Freq.'], mag_tp, label='V(v_tp)')
ax1.set_ylabel('Amplitude [dB]')
ax1.set_title('Amplitudengänge des Gesamtsystems')
ax1.grid(True, which='both', linestyle='--', alpha=0.5)
ax1.legend()

# Phasen-Plot (Unten)
ax2.semilogx(df['Freq.'], phase_f1, label='V(v_f1)')
ax2.semilogx(df['Freq.'], phase_f2, label='V(v_f2)')
ax2.semilogx(df['Freq.'], phase_hp, label='V(v_hp)')
ax2.semilogx(df['Freq.'], phase_tp, label='V(v_tp)')
ax2.set_ylabel('Phase [°]')
ax2.set_xlabel('Frequenz [Hz]')
ax2.set_title('Phasengänge')
ax2.grid(True, which='both', linestyle='--', alpha=0.5)
ax2.legend()

plt.tight_layout()
plt.show()




