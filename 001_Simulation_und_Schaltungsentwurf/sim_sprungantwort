#%% Hüllkurve Hochpass tp


file_path = '008_LTSpice/spice_sprungantwort2.csv'
df = pd.read_csv(file_path, sep='\t')


peaks_hp, _ = find_peaks(df['V(v_hp)'])
peaks_tp, _ = find_peaks(df['V(v_tp)'])


time_hp_env = df['time'].iloc[peaks_hp]
amp_hp_env  = df['V(v_hp)'].iloc[peaks_hp]

time_tp_env = df['time'].iloc[peaks_tp]
amp_tp_env  = df['V(v_tp)'].iloc[peaks_tp]


plt.figure(figsize=(12, 7))
plt.plot(df['time'], df['V(v_hp)'], color=my_blue, linewidth=0.3, alpha=0.3)
plt.plot(df['time'], df['V(v_tp)'], color=my_red, linewidth=0.3, alpha=0.3)
plt.plot(time_hp_env, amp_hp_env, label='Hüllkurve HP', color=my_blue, linewidth=2)
plt.plot(time_tp_env, amp_tp_env, label='Hüllkurve TP', color=my_red, linewidth=2)
plt.axvline(x=0.01, color='black', linestyle='--', label='Frequenzsprung')
plt.axvline(x=0.16, color='black', linestyle='--')

plt.title('Sprungantwort', fontsize=14)
plt.xlabel('Zeit [s]', fontsize=12)
plt.ylabel('Amplitude [V]', fontsize=12)

plt.grid(True, which='major', linestyle='-', alpha=0.4)
plt.grid(True, which='minor', linestyle=':', alpha=0.2)
plt.minorticks_on()

plt.legend(loc='upper right')
plt.tight_layout()
plt.show()

